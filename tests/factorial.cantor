# Factorial using primrec, following the statement example.
main factorial
extended
import relationals

define is_base
    [i == 0]
    compair eq id zero

define previous
    [s(i-1)]
    comp fst snd

define fact_step
    [i * s(i-1)]
    compair mul fst previous

define factorial
    [n!]
    primrec is_base k_1 fact_step
