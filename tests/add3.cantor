main add3
extended

define third
    [Tercer element d'una entrada de tres valors]
    comp snd snd

define second
    [Segon element d'una entrada de tres valors]
    comp fst snd

define add23
    [Segon més tercer]
    compair add second third

define add3
    [Suma dels tres valors]
    compair add fst add23
