main add3
extended

define third
    [Tercer element d' un input de tres valors]
    comp snd snd

define second
    [Segon element d'un input de tres valors]
    comp fst snd

define add23
    [Segon mes tercer]
    compair add second third

define add3
    [Suma de els tres valors]
    compair add fst add23
