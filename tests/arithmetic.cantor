# Divisió, mòdul i paritat. La divisió assumeix divisor > 0.
main mod
extended
import relationals

define vx
    [x dins <<x.y>.q>]
    comp fst fst

define vy
    [y dins <<x.y>.q>]
    comp snd fst

define q1
    [q + 1 dins <<x.y>.q>]
    compair add snd k_1

define yq1
    [y * (q + 1)]
    compair mul vy q1

define test_quotient
    [Troba el primer q tal que y*(q+1) > x]
    compair gt yq1 vx

define div
    [Quocient enter per cerca lineal]
    mu test_quotient

define yq
    [y * div(x,y)]
    compair mul snd div

define mod
    [x mod y]
    compair diff fst yq

define two
    [Constant 2]
    compair add k_1 k_1

define pair_with_two
    [Aparella x amb 2]
    pair id two

define rem_two
    [x mod 2]
    comp mod pair_with_two

define even
    [1 si i només si x és parell]
    comp not rem_two
