# Màxim, mínim i condicional de valors sobre triples <p.<a.b>>.
main max
extended
import relationals

define second
    [Segon valor en un triple]
    comp fst snd

define third
    [Tercer valor en un triple]
    comp snd snd

define predicate
    [Normalitza el primer valor del triple com a booleà]
    comp sign fst

define not_predicate
    [Predicat negat]
    comp not fst

define then_part
    [p * a]
    compair mul predicate second

define else_part
    [not(p) * b]
    compair mul not_predicate third

define cond
    [si p llavors a altrament b]
    compair add then_part else_part

define mm_y_minus_x
    [max(0, y - x)]
    compair diff snd fst

define max
    [Màxim de <x.y>]
    compair add fst mm_y_minus_x

define mm_x_minus_y
    [max(0, x - y)]
    comp diff id

define min
    [Mínim de <x.y>]
    compair diff fst mm_x_minus_y

define max2_args
    [Construeix <gt(x,y).<x.y>> per a cond]
    pair gt id

define max2
    [Màxim usant cond]
    comp cond max2_args
