# Ajudants bàsics compartits pels exemples.
main sign

define zero_pair
    [Aparella x amb ell mateix perquè diff retorni 0]
    pair id id

define zero
    [Constant 0]
    comp diff zero_pair

define aparella_amb_1
    [Aparella l'entrada x amb 1: <x.1>]
    pair id k_1

define anterior
    [Anterior amb limit 0]
    comp diff aparella_amb_1

define sign_pair
    [Aparella x amb el seu predecessor]
    pair id anterior

define sign
    [0 es transforma en 0, els nombres positius es transformen en 1]
    comp diff sign_pair
