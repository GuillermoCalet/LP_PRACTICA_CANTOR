# Funcions booleanes amb 0=fals i 1=cert.
main and
import core

define and
    [Conjunció booleana sobre <a.b>]
    comp sign mul

define or
    [Disjunció booleana sobre <a.b>]
    comp sign add

define not_pair
    [Aparella 1 amb sign(x)]
    pair k_1 sign

define not
    [Negació booleana; qualsevol entrada positiva compta com a cert]
    comp diff not_pair
